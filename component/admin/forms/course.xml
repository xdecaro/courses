<?xml version="1.0" encoding="utf-8"?>
<form>
  <fieldset name="details" label="COM_DECAROCOURSES_FIELDSET_DETAILS">
    <field name="id" type="hidden" filter="integer" />
    <field name="title" type="text" label="COM_DECAROCOURSES_FIELD_TITLE" required="true" maxlength="255" filter="string" />
    <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" maxlength="255" filter="string" />
    <field name="code" type="text" label="COM_DECAROCOURSES_FIELD_CODE" maxlength="80" filter="string" />
    <field name="description" type="textarea" label="COM_DECAROCOURSES_FIELD_DESCRIPTION" rows="6" filter="safehtml" />
    <field name="state" type="list" label="JSTATUS" default="1" filter="integer">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" filter="integer" />
  </fieldset>
</form>
