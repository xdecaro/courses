<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Xdecaro\Component\Decarocourses\Administrator\Field">
  <fieldset name="details" label="COM_DECAROCOURSES_FIELDSET_DETAILS">
    <field name="id" type="hidden" />
    <field name="course_id" type="sql" label="COM_DECAROCOURSES_FIELD_COURSE" required="true" query="SELECT id AS value, title AS text FROM #__decarocourses_courses WHERE state = 1 ORDER BY title ASC" key_field="value" value_field="text" />
    <field name="title" type="text" label="COM_DECAROCOURSES_FIELD_EDITION_TITLE" required="true" maxlength="255" />
    <field name="academic_year" type="text" label="COM_DECAROCOURSES_FIELD_ACADEMIC_YEAR" placeholder="2026/2027" maxlength="20" />
    <field name="format" type="list" label="COM_DECAROCOURSES_FIELD_FORMAT" default="annual">
      <option value="annual">COM_DECAROCOURSES_FORMAT_ANNUAL</option>
      <option value="intensive">COM_DECAROCOURSES_FORMAT_INTENSIVE</option>
      <option value="evening">COM_DECAROCOURSES_FORMAT_EVENING</option>
      <option value="custom">COM_DECAROCOURSES_FORMAT_CUSTOM</option>
    </field>
    <field name="start_date" type="calendar" label="COM_DECAROCOURSES_FIELD_START_DATE" format="%Y-%m-%d" showtime="false" translateformat="true" />
    <field name="end_date" type="calendar" label="COM_DECAROCOURSES_FIELD_END_DATE" format="%Y-%m-%d" showtime="false" translateformat="true" />
    <field name="registration_start" type="calendar" label="COM_DECAROCOURSES_FIELD_REGISTRATION_START" format="%Y-%m-%d" showtime="false" translateformat="true" />
    <field name="registration_end" type="calendar" label="COM_DECAROCOURSES_FIELD_REGISTRATION_END" format="%Y-%m-%d" showtime="false" translateformat="true" />
    <field name="capacity" type="number" label="COM_DECAROCOURSES_FIELD_CAPACITY" min="0" default="0" />
    <field name="status" type="list" label="COM_DECAROCOURSES_FIELD_STATUS" default="draft">
      <option value="draft">COM_DECAROCOURSES_STATUS_DRAFT</option>
      <option value="registrations_open">COM_DECAROCOURSES_STATUS_REGISTRATIONS_OPEN</option>
      <option value="scheduled">COM_DECAROCOURSES_STATUS_SCHEDULED</option>
      <option value="active">COM_DECAROCOURSES_STATUS_ACTIVE</option>
      <option value="completed">COM_DECAROCOURSES_STATUS_COMPLETED</option>
      <option value="archived">COM_DECAROCOURSES_STATUS_ARCHIVED</option>
    </field>
    <field name="forms_form_id" type="formslist" label="COM_DECAROCOURSES_FIELD_FORMS_FORM" description="COM_DECAROCOURSES_FIELD_FORMS_FORM_DESC" />
    <field name="notes" type="textarea" label="COM_DECAROCOURSES_FIELD_NOTES" rows="5" />
    <field name="state" type="list" label="JSTATUS" default="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="-2">JTRASHED</option>
    </field>
  </fieldset>
</form>
